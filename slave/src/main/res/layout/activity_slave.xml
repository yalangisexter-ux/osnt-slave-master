<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0a0e15" android:padding="10dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Chat" android:textColor="#34d399" android:textSize="20sp"
        android:textStyle="bold" android:layout_marginBottom="8dp"/>
    <ListView android:id="@+id/list" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:background="#141b26"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <EditText android:id="@+id/input" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:hint="Message" android:background="#141b26"
            android:textColor="#e8eef7" android:padding="10dp"/>
        <Button android:id="@+id/btn_send" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Send" android:background="#34d399" android:textColor="#0a0e15"/>
    </LinearLayout>
</LinearLayout>