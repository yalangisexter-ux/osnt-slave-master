<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#080D18" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="MASTER CONTROL" android:textColor="#F8FAFC" android:textSize="24sp"
        android:textStyle="bold" android:letterSpacing="0.04"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Peer connection and message monitor" android:textColor="#94A3B8"
        android:textSize="12sp" android:layout_marginBottom="12dp"/>
    <Button android:id="@+id/btn_update" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Check for updates" android:backgroundTint="#1E293B" android:textColor="#E2E8F0"/>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Starting listener…" android:textColor="#93C5FD" android:textSize="12sp"
        android:padding="10dp" android:background="#111827" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Direct TCP is intended for trusted networks. Internet access may require firewall/router configuration."
        android:textColor="#94A3B8" android:textSize="12sp" android:layout_marginBottom="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
        <EditText android:id="@+id/peer_ip" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:hint="Slave IP / hostname" android:inputType="textUri"
            android:singleLine="true" android:backgroundTint="#475569" android:textColor="#F8FAFC"
            android:textColorHint="#94A3B8" android:padding="10dp"/>
        <Button android:id="@+id/btn_connect" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Test" android:backgroundTint="#2563EB" android:textColor="#FFFFFF"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="ACTIVITY" android:textColor="#CBD5E1" android:textStyle="bold" android:textSize="12sp"
        android:layout_marginBottom="6dp"/>
    <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="#111827" android:divider="#263244" android:dividerHeight="1dp"
        android:padding="4dp" android:clipToPadding="false"/>
</LinearLayout>