<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#0B1020">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_hamburger"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_action_button"
                android:contentDescription="Menu"
                android:src="@android:drawable/ic_menu_sort_by_size" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="OSINT WORKSPACE"
                    android:textColor="#F8FAFC"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="All-in-one OSINT suite"
                    android:textColor="#9AA8C2"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_action_button"
                android:contentDescription="Back"
                android:src="@android:drawable/ic_menu_revert" />
            <ImageButton
                android:id="@+id/btn_forward"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_action_button"
                android:contentDescription="Forward"
                android:src="@android:drawable/ic_menu_set_as" />
            <ImageButton
                android:id="@+id/btn_refresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_action_button"
                android:contentDescription="Refresh"
                android:src="@android:drawable/ic_menu_rotate" />
        </LinearLayout>

        <!-- Tabs & ViewPager hidden until wired to an adapter -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/in_query"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:hint="Name or username (authorized investigation)"
            android:singleLine="true"
            android:background="@drawable/bg_input"
            android:textColor="#F8FAFC"
            android:textColorHint="#8290AA"
            android:paddingHorizontal="14dp" />

        <EditText
            android:id="@+id/in_emails"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:hint="Email addresses (comma-separated)"
            android:singleLine="true"
            android:inputType="textEmailAddress"
            android:background="@drawable/bg_input"
            android:textColor="#F8FAFC"
            android:textColorHint="#8290AA"
            android:paddingHorizontal="14dp" />

        <EditText
            android:id="@+id/in_phones"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:hint="Phone numbers (comma-separated)"
            android:singleLine="true"
            android:inputType="phone"
            android:background="@drawable/bg_input"
            android:textColor="#F8FAFC"
            android:textColorHint="#8290AA"
            android:paddingHorizontal="14dp" />

        <EditText
            android:id="@+id/in_social_accounts"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:hint="Known social usernames / profile names"
            android:singleLine="true"
            android:background="@drawable/bg_input"
            android:textColor="#F8FAFC"
            android:textColorHint="#8290AA"
            android:paddingHorizontal="14dp" />

        <EditText
            android:id="@+id/in_domain"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:hint="Username or organization (optional)"
            android:singleLine="true"
            android:background="@drawable/bg_input"
            android:textColor="#F8FAFC"
            android:textColorHint="#8290AA"
            android:paddingHorizontal="14dp" />

        <EditText
            android:id="@+id/in_url"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:hint="Profile URL (optional)"
            android:singleLine="true"
            android:background="@drawable/bg_input"
            android:textColor="#F8FAFC"
            android:textColorHint="#8290AA"
            android:paddingHorizontal="14dp" />

        <EditText
            android:id="@+id/in_file_path"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:hint="File path (optional)"
            android:singleLine="true"
            android:background="@drawable/bg_input"
            android:textColor="#F8FAFC"
            android:textColorHint="#8290AA"
            android:paddingHorizontal="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Spinner
                android:id="@+id/spin_engine"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="2"
                android:background="@drawable/bg_input" />

            <Spinner
                android:id="@+id/spin_mode"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_input" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_search"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Search All Public Sources"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:background="@drawable/bg_primary_button"
            android:textColor="#06101C" />

        <Button
            android:id="@+id/btn_upload_image"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:text="Upload Image for Reverse Search"
            android:textAllCaps="false"
            android:background="@drawable/bg_action_button"
            android:textColor="#DCE7FA" />

        <!-- ONE-TAP CONNECT ROW -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="ONE-TAP CONNECT"
            android:textColor="#AEBBD2"
            android:textStyle="bold"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button android:id="@+id/quick_tor" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="🧅 Tor" android:textSize="11sp" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/quick_vpn" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="🔐 VPN" android:textSize="11sp" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/quick_dark" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="🌑 Dark" android:textSize="11sp" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button android:id="@+id/quick_onion" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="🧅 .Onion list" android:textSize="11sp" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/quick_telegram" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="✈️ Telegram bot" android:textSize="11sp" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/quick_whatsapp" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="📱 WhatsApp bot" android:textSize="11sp" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="10dp"
            android:text="Ready"
            android:textColor="#8BE9FD"
            android:textSize="12sp"
            android:background="@drawable/bg_status_card"
            android:maxLines="2" />

        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone"
            android:background="#FFFFFF"
            android:layout_marginTop="10dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#111A2D"
        android:elevation="16dp"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OSINT WORKSPACE"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingTop="12dp"
                android:paddingBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SEARCH &amp; TOOLS"
                android:textColor="#AEBBD2"
                android:textStyle="bold"
                android:textSize="11sp" />

            <Button android:id="@+id/btn_search2" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="⌕  Search all sources" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_dork" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="📝  Google dorks" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_dorks" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="🔍  Dork generator" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_images" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="🖼  Reverse image search" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_face" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="👤  Face search" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_password" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="🔑  Password strength" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_hpb" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="🏥  Health / PHB check" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DARK WEB &amp; VPN"
                android:textColor="#AEBBD2"
                android:textStyle="bold"
                android:textSize="11sp"
                android:layout_marginTop="16dp" />

            <Button android:id="@+id/btn_tor" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="🧅  Tor browser" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_dark" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="🌑  Dark web search" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_vpn" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="🔐  VPN / WireGuard" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_web" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="🌐  Normal browser" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_onion_list" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="🧅  Browse .onion sites" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LEAKS &amp; BREACHES"
                android:textColor="#AEBBD2"
                android:textStyle="bold"
                android:textSize="11sp"
                android:layout_marginTop="16dp" />

            <Button android:id="@+id/btn_leaks" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="💣  Leaks search" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_leaksio" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="🌐  Leaks.io lookup" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_social" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="📱  Social media leaks" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_icloud" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="☁️  iCloud leaks" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_drive" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="📁  Google Drive leaks" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_cloud" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="☁️  Cloud leaks (AWS/GCP/Azure)" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_telecom" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="📞  Telecom / SIM leaks" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_email" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="📧  Email leak check" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_dating" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="❤️  Dating app leaks" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_hotel" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="🏨  OYO / Hotel leaks" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ADULT &amp; STREAMING"
                android:textColor="#AEBBD2"
                android:textStyle="bold"
                android:textSize="11sp"
                android:layout_marginTop="16dp" />

            <Button android:id="@+id/btn_porn" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="🔞  Adult / Porn search" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_cams" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="📹  Cam / Stream leaks" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_stream" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="📺  Live stream check" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_video" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="🎬  Video leaks" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_escort" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="💃  Escort / Dating sites" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FILES"
                android:textColor="#AEBBD2"
                android:textStyle="bold"
                android:textSize="11sp"
                android:layout_marginTop="16dp" />

            <Button android:id="@+id/btn_files" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="📂  File search" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_photos" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="📷  Photo search" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_docs" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="📄  Document leaks" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_pdfs" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="📑  PDF search" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOOLS"
                android:textColor="#AEBBD2"
                android:textStyle="bold"
                android:textSize="11sp"
                android:layout_marginTop="16dp" />

            <Button android:id="@+id/btn_brute" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="🔑  Brute force / wordlist" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_otp" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="📲  OTP bypass" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_telegram_bot" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="✈️  Telegram bot" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_whatsapp_bot" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="📱  WhatsApp bot" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="APP"
                android:textColor="#AEBBD2"
                android:textStyle="bold"
                android:textSize="11sp"
                android:layout_marginTop="16dp" />

            <Button android:id="@+id/btn_clear" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="🗑  Clear inputs" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />
            <Button android:id="@+id/btn_update" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="🔄  Check for updates" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#C5F6FF" />
            <Button android:id="@+id/btn_playprotect" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="🛡  Bypass Play Protect" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#C5F6FF" />
            <Button android:id="@+id/btn_settings" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="⚙️  Settings" android:textAllCaps="false" android:background="@drawable/bg_action_button" android:textColor="#DCE7FA" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OSINT Workspace · v2.0"
                android:textColor="#8290AA"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingTop="20dp"
                android:paddingBottom="16dp" />
        </LinearLayout>
    </ScrollView>
</androidx.drawerlayout.widget.DrawerLayout>